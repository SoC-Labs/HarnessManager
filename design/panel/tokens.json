{
  "schema": "soclabs-harness-tokens/1",
  "about": "The one source of Harness Manager's design tokens (decision P4). tools/gen_tokens.py generates the web UI's src/harness_manager/web/static/css/tokens.css, design/generated/palette.json and design/generated/clcd_palette.h (RGB565, for the Linux harness's panel renderer) from it; `make check` fails when any of them is stale, or when app.css defines a colour of its own. 'color' and 'effect' are per theme; 'static' is the same in both. 'held' (violet: someone else has it) is decision P6. 'panel' maps the grammar onto the MPS3's 320x240 RGB565 front panel (CLCD), Linux harness only (P3). See docs/design/CLCD_ALIGNMENT.md section 4.",
  "static": {
    "font-sans": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "font-mono": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace",
    "radius": "10px",
    "radius-sm": "6px"
  },
  "color": {
    "bg":             {"light": "#f4f5f7", "dark": "#0f1216"},
    "rail":           {"light": "#eceef2", "dark": "#0c0e12"},
    "surface":        {"light": "#ffffff", "dark": "#161a20"},
    "surface-2":      {"light": "#f7f8fa", "dark": "#1b2028"},
    "hover":          {"light": "#f0f2f5", "dark": "#1f252e"},
    "border":         {"light": "#e0e3e8", "dark": "#272d37"},
    "border-strong":  {"light": "#c9ced6", "dark": "#353d49"},
    "text":           {"light": "#191d23", "dark": "#e4e7ec"},
    "text-2":         {"light": "#4b535f", "dark": "#a9b1bd"},
    "text-3":         {"light": "#767e8a", "dark": "#7e8794"},
    "accent":         {"light": "#2f5bd3", "dark": "#7d9cf4"},
    "accent-hover":   {"light": "#2650c0", "dark": "#95aff7"},
    "accent-soft":    {"light": "#e9eefb", "dark": "#1b2440"},
    "accent-border":  {"light": "#bccbf2", "dark": "#2f3f6e"},
    "accent-text":    {"light": "#2449b0", "dark": "#a8bcf8"},
    "on-accent":      {"light": "#ffffff", "dark": "#0f1216"},
    "on-err":         {"light": "#ffffff", "dark": "#0f1216"},
    "on-badge":       {"light": "#ffffff", "dark": "#ffffff"},
    "ok":             {"light": "#1b7a48", "dark": "#5cc68c"},
    "ok-soft":        {"light": "#e7f4ec", "dark": "#122419"},
    "ok-border":      {"light": "#b7dcc6", "dark": "#214a33"},
    "warn":           {"light": "#945800", "dark": "#e8ad58"},
    "warn-soft":      {"light": "#fcf1de", "dark": "#291f11"},
    "warn-border":    {"light": "#eed19e", "dark": "#574220"},
    "err":            {"light": "#b1261d", "dark": "#f08b82"},
    "err-soft":       {"light": "#fbeceb", "dark": "#2b1616"},
    "err-border":     {"light": "#edbdb9", "dark": "#5a2a27"},
    "unk":            {"light": "#665d40", "dark": "#cbc19e"},
    "unk-soft":       {"light": "#f3f1e9", "dark": "#22201a"},
    "unk-border":     {"light": "#c7bd9b", "dark": "#4c4632"},
    "held":           {"light": "#6b3fc4", "dark": "#b69cf5"},
    "held-soft":      {"light": "#f1ebfb", "dark": "#1f1830"},
    "held-border":    {"light": "#d4c3f2", "dark": "#45376a"},
    "term-bg":        {"light": "#fbfbfc", "dark": "#0c0f13"},
    "term-fg":        {"light": "#1f242b", "dark": "#d9dde3"},
    "term-cursor":    {"light": "#2f5bd3", "dark": "#7d9cf4"},
    "term-selection": {"light": "rgba(47, 91, 211, 0.22)", "dark": "rgba(125, 156, 244, 0.28)"},
    "scrim":          {"light": "rgba(10, 12, 16, 0.45)", "dark": "rgba(10, 12, 16, 0.45)"}
  },
  "effect": {
    "ring":       {"light": "0 0 0 3px rgba(47, 91, 211, 0.35)", "dark": "0 0 0 3px rgba(125, 156, 244, 0.45)"},
    "shadow":     {"light": "0 1px 2px rgba(16, 24, 40, 0.05)", "dark": "0 1px 2px rgba(0, 0, 0, 0.3)"},
    "shadow-pop": {"light": "0 8px 28px rgba(16, 24, 40, 0.14)", "dark": "0 10px 32px rgba(0, 0, 0, 0.5)"}
  },
  "grammar": {
    "ok":   {"color": "ok",     "icon": "circle-check",   "glyph": "ok",   "ascii": "OK", "means": "working and proven: verified, up, locked, yours and healthy"},
    "warn": {"color": "warn",   "icon": "triangle-alert", "glyph": "warn", "ascii": "!",  "means": "works, but needs attention soon: lease ending, not leased, busy control port"},
    "err":  {"color": "err",    "icon": "circle-x",       "glyph": "err",  "ascii": "X",  "means": "broken now: link down, program failed, clock dead, wedged"},
    "busy": {"color": "accent", "icon": "loader-circle",  "glyph": "busy", "ascii": "|/-\\", "means": "an operation is running: programming, rebooting, identify"},
    "unk":  {"color": "unk",    "icon": "circle-help",    "glyph": "unk",  "ascii": "?",  "means": "not checked or not known; never drawn like ok"},
    "held": {"color": "held",   "icon": "lock",           "glyph": "held", "ascii": "#",  "means": "someone else holds it: the lease, the control port, the panel (DUT)"},
    "mine": {"color": "accent", "icon": "user",           "glyph": "user", "ascii": "@",  "means": "you hold it (the web UI knows who 'you' are; the panel never does)"}
  },
  "names": {
    "board":   {"say": "board",   "lcd": "",       "example": "mps3-01", "note": "N1 display name, lower case with hyphens; the panel shows the same string"},
    "shell":   {"say": "shell",   "lcd": "SHELL",  "example": "0x72bb0a36", "note": "the static image; never 'SID' or 'static' in UI text"},
    "design":  {"say": "design",  "lcd": "DESIGN", "example": "nanosoc v1.0", "note": "what the partition holds now (the RM)"},
    "overlay": {"say": "overlay", "lcd": "",       "example": "nanosoc", "note": "the file you program; the card slots hold overlays"},
    "program": {"say": "program", "lcd": "PROG",   "example": "#001 verified", "note": "the action; replaces SWAP on the panel"},
    "card":    {"say": "card",    "lcd": "CARD",   "example": "nanosoc [A]", "note": "the user microSD (D13); replaces USD on the panel"},
    "lease":   {"say": "lease",   "lcd": "LEASE",  "example": "david 1h12m +1", "note": "hub lease; '+N' is the queue length"},
    "session": {"say": "Harness Manager", "lcd": "HM", "example": "david@srv03335", "note": "a Harness Manager that sent hello within its TTL"},
    "harness": {"say": "harness", "lcd": "",       "example": "linux 0.14", "note": "the board-side engine: bare-metal or linux"}
  },
  "panel": {
    "size_px": [320, 240],
    "grid": [40, 15],
    "font": "X11 misc-fixed 8x16, ASCII 0x20-0x7E (firmware/clcd/font8x16.h)",
    "depth": "RGB565, high byte first (firmware/clcd/clcd.c:941-942)",
    "channel_order": "RGB: clcd_demo bar order on silicon, 2026-09-23 (docs/evidence/2026-09-w2/p5_clcd_demo_20260923.txt:23-25). White looks pale blue on camera: white-point, not order",
    "theme": "dark",
    "bg_override": "#000000",
    "roles": {
      "text":        {"fg": "text",          "bg": "bg"},
      "label":       {"fg": "text-3",        "bg": "bg"},
      "value":       {"fg": "text",          "bg": "bg"},
      "rule":        {"fg": "border-strong", "bg": "bg"},
      "chrome":      {"fg": "text-2",        "bg": "surface-2"},
      "title":       {"fg": "text",          "bg": "surface-2"},
      "title-held":  {"fg": "held",          "bg": "surface-2"},
      "title-warn":  {"fg": "warn",          "bg": "surface-2"},
      "ok":          {"fg": "ok",            "bg": "bg"},
      "warn":        {"fg": "warn",          "bg": "bg"},
      "err":         {"fg": "err",           "bg": "bg"},
      "busy":        {"fg": "accent",        "bg": "bg"},
      "unk":         {"fg": "unk",           "bg": "bg"},
      "held":        {"fg": "held",          "bg": "bg"},
      "bar":         {"fg": "bg",            "bg": "accent"},
      "track":       {"fg": "text-3",        "bg": "surface-2"},
      "banner-err":  {"fg": "#ffffff",       "bg": "err@light"},
      "banner-warn": {"fg": "#ffffff",       "bg": "warn@light"},
      "banner-ok":   {"fg": "#ffffff",       "bg": "ok@light"},
      "banner-busy": {"fg": "#ffffff",       "bg": "accent@light"},
      "banner-held": {"fg": "#ffffff",       "bg": "held@light"}
    }
  }
}
