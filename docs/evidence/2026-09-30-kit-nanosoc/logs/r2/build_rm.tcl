# KIT_ID            which kit this script was generated from (goes in the receipt)
# VIVADO_VERSION    the release that wrote the static: another major.minor is REFUSED
#                   (a checkpoint opens only in its own release); VIVADO_BUILD differing
#                   is only noted
# STATIC_DCP        the kit's static_routed_locked.dcp ("harness-manager kit fetch")
# PR_VERIFY_REF     a routed reference config of the SAME static; empty = the
#                   locked static itself (see the guide: "what pr_verify compares")
# RP_PBLOCK         the partition's pblock (utilization is reported against it)
# CLEARING_MAX      bytes; the harness stages a bigger clearing to QSPI, and the
#                   next swap-away then fails closed (HM deploy preflight (d))
# RM_SOURCES        .sv/.v/.vhd files, in order. Or leave empty and read them in
# RM_GENERICS       NAME=VALUE top-level parameters, one -generic each (a $readmemh
#                   image's path is ABSOLUTE: Vivado's cwd is not this directory)
# RM_GENERIC_FILES  the files those generics name; preflight refuses a missing one
#                   ($readmemh of a missing file is only a warning, and a blank ROM)
# RM_SYNTH_HOOK     a Tcl file sourced inside the synth project (filelists,
#                   read_ip, create_ip for an RM debug hub, set_property ...)
# RM_SYNTH_DCP      skip synthesis: an out-of-context synth checkpoint of RM_TOP
# RM_OOC_XDC        the XDC kit's <name>_ooc.xdc ("harness-manager xdc rm-kit")
# RM_XDC            optional RM-internal timing exceptions, applied -cell RP_INST
# STOP_AFTER        preflight | synth | link | impl | verify | bitstream (= all)
# ALLOW_TIMING_FAIL 1 = report negative slack in your RM but still write bits

foreach arg $argv {
    if { [regexp {^([A-Z_]+)=(.*)$} $arg -> k v] } {
        if { ![info exists P($k)] } { error "build_rm.tcl: unknown parameter '$k' in -tclargs" }
        set P($k) $v
    }
}

# Relative paths are relative to this script's directory (not the shell's cwd).
set HERE [file dirname [file normalize [info script]]]
proc here_path { p } {
    if { $p eq "" || [file pathtype $p] ne "relative" } { return $p }
    return [file join $::HERE $p]
}
foreach k {STATIC_DCP PR_VERIFY_REF RM_SYNTH_HOOK RM_SYNTH_DCP RM_OOC_XDC RM_XDC OUT_DIR} {
    set P($k) [here_path $P($k)]
}
foreach k {RM_SOURCES RM_INCLUDE_DIRS RM_GENERIC_FILES} {
    set l {}
    foreach f $P($k) { lappend l [here_path $f] }
    set P($k) $l
}

set STAGES {preflight synth link impl verify bitstream}
set stop_idx [lsearch -exact $STAGES $P(STOP_AFTER)]
if { $stop_idx < 0 } { set stop_idx [expr {[llength $STAGES] - 1}] }

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------
set ::gates {}
proc gate { name ok detail } {
    set verdict [expr { $ok ? "PASS" : "FAIL" }]
    puts "HM_GATE $name $verdict $detail"
    lappend ::gates [list $name $verdict $detail]
    if { !$ok } {
        set ::gate_failed 1
        puts "HM_RM_BUILD_FAILED gate=$name"
        write_receipt failed
        error "build_rm.tcl: gate '$name' failed: $detail"
    }
}
proc note { name detail } {
    puts "HM_GATE $name NOTE $detail"
    lappend ::gates [list $name NOTE $detail]
}
proc stage { n } { puts "HM_STAGE $n"; set ::stage $n }
proc done_after { n } {
    if { [lsearch -exact $::STAGES $n] >= $::stop_idx } {
        write_receipt stopped
        puts "HM_RM_BUILD_STOPPED after=$n"
        return 1
    }
    return 0
}

# zlib/IEEE CRC-32 of a file, 1 MiB chunks: the same number as Python's
# zlib.crc32, pyverify and the wire header (build_dfx.tcl:420-430).
proc file_crc32 { path } {
    set fh [open $path rb]
    set crc 0
    while { 1 } {
        set chunk [read $fh 1048576]
        if { [string length $chunk] == 0 } { break }
        set crc [zlib crc32 $chunk $crc]
    }
    close $fh
    return [expr { $crc & 0xFFFFFFFF }]
}
proc hex32 { v } { return [format "0x%08X" [expr { $v & 0xFFFFFFFF }]] }
# "2024.1.2" -> "2024.1": the part of a release a checkpoint is bound to.
proc major_minor { v } {
    if { [regexp {^(\d{4})\.(\d+)} $v -> a b] } { return "$a.$b" }
    return $v
}
proc json_str { s } {
    return "\"[string map {\\ \\\\ \" \\\" \n \\n \r \\r \t \\t} $s]\""
}

# The rm_id the NETLIST drives, read from the constant drivers of rm_id[31:0].
# `objs` are the 32 bit-objects (OOC: ports; after link: RP pins). Returns the
# value, or "" if any bit is not driven by a constant (GND/VCC).
proc netlist_rm_id { objs } {
    set v 0
    foreach o $objs {
        if { ![regexp {\[(\d+)\]$} $o -> bit] } { return "" }
        set drv [get_pins -quiet -leaf -filter {DIRECTION == OUT} \
                    -of_objects [get_nets -quiet -segments -of_objects $o]]
        set ref ""
        if { [llength $drv] == 1 } { set ref [get_property REF_NAME [get_cells -of_objects $drv]] }
        switch -- $ref {
            GND { }
            VCC { set v [expr { $v | (1 << $bit) }] }
            default { return "" }
        }
    }
    return $v
}

# Worst setup and hold slack over paths that START or END in the RP -- your
# RM's paths, not the static's headline (the static is locked and was signed
# off at the mint; a negative headline elsewhere is not yours to fix).
proc rp_slack { rp_inst } {
    set regs [get_cells -quiet -hierarchical -filter "NAME =~ ${rp_inst}/* && IS_SEQUENTIAL"]
    if { [llength $regs] == 0 } { return [list "" "" 0] }
    set out {}
    foreach kind {-setup -hold} {
        set worst ""
        foreach dir {-to -from} {
            set p [get_timing_paths -quiet $kind -max_paths 1 -nworst 1 $dir $regs]
            if { $p ne "" } {
                set s [get_property SLACK $p]
                if { $s ne "" && ($worst eq "" || $s < $worst) } { set worst $s }
            }
        }
        lappend out $worst
    }
    lappend out [llength $regs]
    return $out
}

# DRC blockers in the last report_drc: HDPR-16/-18/-50 at any severity, and any
# Error (scripts/harness_gates/check_hdpr_reports.py). A violation's NAME is
# "<RULE>#<n>"; warnings the fielded configs all carry (REQP-1934, BUFC-1,
# PDRC-153, RTSTAT-10 ...) are not blockers.
proc drc_blockers {} {
    set bad {}
    foreach v [get_drc_violations -quiet] {
        regsub {#.*$} [get_property NAME $v] "" rule
        if { $rule in {HDPR-16 HDPR-18 HDPR-50} || [get_property SEVERITY $v] eq "Error" } {
            lappend bad $rule
        }
    }
    return [lsort -unique $bad]
}

set ::receipt [dict create]
proc rset { k v } { dict set ::receipt $k $v }
proc write_receipt { state } {
    global P
    if { ![file isdirectory $P(OUT_DIR)] } { return }
    set f [file join $P(OUT_DIR) "$P(RM_NAME)_build.json"]
    set fh [open $f w]
    puts $fh "\{"
    puts $fh "  \"schema\": \"harness-manager-rm-build\", \"schema_version\": 1,"
    puts $fh "  \"state\": [json_str $state], \"stage\": [json_str $::stage],"
    puts $fh "  \"kit_id\": [json_str $P(KIT_ID)],"
    foreach k [lsort [dict keys $::receipt]] {
        puts $fh "  [json_str $k]: [json_str [dict get $::receipt $k]],"
    }
    set rows {}
    foreach g $::gates {
        lassign $g n v d
        lappend rows "    \{\"gate\": [json_str $n], \"verdict\": [json_str $v], \"detail\": [json_str $d]\}"
    }
    puts $fh "  \"gates\": \[\n[join $rows ",\n"]\n  \]"
    puts $fh "\}"
    close $fh
    puts "HM_RECEIPT $f"
}

set ::stage init
set ::gate_failed 0
set rp $P(RP_INST)
set out $P(OUT_DIR)
set name $P(RM_NAME)

# Every stage runs inside one catch: a gate that fails has already said so and
# written the receipt; ANY other Tcl error (a Vivado command refusing its
# arguments, a missing file) becomes the gate `tcl_error`, so a build can never
# end without a verdict. `return` (STOP_AFTER) is code 2 and is a clean stop.
set rc [catch {
    # ===========================================================================
    # STAGE 1 -- preflight: the cheap refusals, before any Vivado time is spent
    # ===========================================================================
    stage preflight
    file mkdir $out
    rset rm_name $name
    rset rm_top $P(RM_TOP)
    rset part $P(PART)
    rset rp_inst $rp

    set_param general.maxThreads $P(JOBS)
    set vv [version -short]
    rset vivado $vv
    # A routed DCP opens only in the Vivado release that wrote it (a 2026.1 DCP
    # does not open in 2024.1, and the reverse is refused as a downgrade risk).
    # The rule (david K4): another major.minor is REFUSED here, before an hour of
    # synthesis; another build of the same release is only noted.
    gate vivado_version [string equal [major_minor $vv] [major_minor $P(VIVADO_VERSION)]] \
        "running Vivado $vv; the kit's static was written by $P(VIVADO_VERSION), and a checkpoint opens only in the major.minor release that wrote it"
    if { $P(VIVADO_BUILD) ne "" && [regexp {SW Build (\d+)} [version] -> vb] && $vb ne $P(VIVADO_BUILD) } {
        note vivado_build "running build $vb; the static was written by build $P(VIVADO_BUILD) (the same release: going on)"
    }

    gate part_installed [expr { [llength [get_parts -quiet $P(PART)]] == 1 }] \
        "$P(PART) (install the device family with Vivado; licensing is checked at synth)"

    gate static_dcp_present [file isfile $P(STATIC_DCP)] $P(STATIC_DCP)
    # static_id IS the CRC-32 of static_routed_locked.dcp (build_dfx.tcl:725), so the
    # kit's DCP can be proven to be the board's static without opening it.
    set sid [hex32 [file_crc32 $P(STATIC_DCP)]]
    rset static_id $sid
    rset static_usercode $P(STATIC_USERCODE)
    gate static_id [string equal -nocase $sid $P(STATIC_ID)] \
        "CRC-32 of [file tail $P(STATIC_DCP)] is $sid, the kit is for $P(STATIC_ID)"

    if { $P(PR_VERIFY_REF) ne "" } {
        gate pr_verify_ref_present [file isfile $P(PR_VERIFY_REF)] $P(PR_VERIFY_REF)
    }
    if { ![regexp {^0[xX][0-9A-Fa-f_]{1,9}$} $P(RM_ID)] } {
        gate rm_id_format 0 "RM_ID '$P(RM_ID)' is not a 32-bit hex literal"
    }
    set want_rm_id [expr { [string map {_ ""} $P(RM_ID)] & 0xFFFFFFFF }]
    rset rm_id [hex32 $want_rm_id]
    if { $want_rm_id == 0 } {
        gate rm_id_nonzero 0 "rm_id 0x00000000 is the greybox's; give your RM its own id"
    }
    if { $P(RM_SYNTH_DCP) eq "" } {
        foreach f [concat $P(RM_SOURCES) $P(RM_SYNTH_HOOK)] {
            gate source_present [file isfile $f] $f
        }
        if { [llength $P(RM_SOURCES)] == 0 && $P(RM_SYNTH_HOOK) eq "" } {
            gate sources_given 0 "set RM_SOURCES or RM_SYNTH_HOOK (or RM_SYNTH_DCP)"
        }
        gate ooc_xdc_present [file isfile $P(RM_OOC_XDC)] \
            "$P(RM_OOC_XDC) (harness-manager xdc rm-kit writes it)"
        foreach f $P(RM_GENERIC_FILES) {
            gate generic_file_present [file isfile $f] $f
        }
    } else {
        gate synth_dcp_present [file isfile $P(RM_SYNTH_DCP)] $P(RM_SYNTH_DCP)
    }
    if { $P(RM_XDC) ne "" } { gate rm_xdc_present [file isfile $P(RM_XDC)] $P(RM_XDC) }
    if { [done_after preflight] } { return }

    # ===========================================================================
    # STAGE 2 -- out-of-context synthesis (or your own synth checkpoint)
    # ===========================================================================
    stage synth
    set synth_dcp [file join $out "${name}_synth.dcp"]
    if { $P(RM_SYNTH_DCP) eq "" } {
        create_project -in_memory -part $P(PART)
        foreach f $P(RM_SOURCES) {
            switch -glob -- [string tolower $f] {
                *.vhd - *.vhdl { read_vhdl $f }
                *.v            { read_verilog $f }
                default        { read_verilog -sv $f }
            }
        }
        if { $P(RM_SYNTH_HOOK) ne "" } { source $P(RM_SYNTH_HOOK) }
        set sargs [list -mode out_of_context -top $P(RM_TOP) -part $P(PART)]
        if { $P(RM_INCLUDE_DIRS) ne "" } { lappend sargs -include_dirs $P(RM_INCLUDE_DIRS) }
        foreach d $P(RM_DEFINES) { lappend sargs -verilog_define $d }
        # -generic is REPEATED, one per generic: Vivado takes no list
        foreach g $P(RM_GENERICS) { lappend sargs -generic $g }
        synth_design {*}$sargs
        # read AFTER synth_design: it names ports and synthesised pins
        # (_template/ooc_synth.tcl:69-80)
        read_xdc $P(RM_OOC_XDC)
        report_utilization    -file [file join $out "${name}_synth_util.rpt"]
        report_timing_summary -file [file join $out "${name}_synth_timing.rpt"]
        write_checkpoint -force $synth_dcp
    } else {
        open_checkpoint $P(RM_SYNTH_DCP)
        file copy -force $P(RM_SYNTH_DCP) $synth_dcp
    }

    # A missing source does not fail synthesis: it synthesises as a black box and the
    # RM links EMPTY (the platform's "synth_mode inline" trap, adding-an-rm.md).
    set bb [get_cells -quiet -hierarchical -filter {IS_BLACKBOX}]
    gate no_black_boxes [expr { [llength $bb] == 0 }] \
        [expr { [llength $bb] ? "black boxes: [lrange $bb 0 4] (a source file is missing)" : "none" }]

    # The OOC netlist's bit-level port count is the boundary (boundary.yaml totals.bits).
    set nports [llength [get_ports -quiet]]
    gate boundary_bits [expr { $nports == $P(BOUNDARY_BITS) }] \
        "$nports port bits, the partition has $P(BOUNDARY_BITS) (compare your wrapper with the kit's skeleton)"

    set got [netlist_rm_id [lsort -dictionary [get_ports -quiet {rm_id[*]}]]]
    if { $got eq "" } {
        gate rm_id_constant 0 "rm_id\[31:0\] is not driven by constants in the netlist"
    }
    rset rm_id_netlist [hex32 $got]
    gate rm_id_match [expr { $got == $want_rm_id }] \
        "the netlist drives rm_id [hex32 $got], RM_ID is [hex32 $want_rm_id] (the shell compares them after every swap)"

    set ooc_clocks [get_clocks -quiet]
    gate ooc_clocks [expr { [llength $ooc_clocks] > 0 }] \
        "OOC clocks: $ooc_clocks (none = nothing was timed; read the kit's OOC XDC)"
    close_project
    if { [done_after synth] } { return }

    # ===========================================================================
    # STAGE 3 -- link into the locked static
    # ===========================================================================
    stage link
    open_checkpoint $P(STATIC_DCP)
    set rp_cell [get_cells -quiet $rp]
    gate rp_cell [expr { $rp_cell ne "" }] "$rp in [file tail $P(STATIC_DCP)]"
    if { ![get_property IS_BLACKBOX $rp_cell] } {
        # a static shipped with an inert stub in the partition (build_dfx.tcl:235-242)
        update_design -cells $rp_cell -black_box
    }
    read_checkpoint -cell $rp_cell $synth_dcp

    set npins [llength [get_pins -quiet ${rp}/*]]
    gate rp_pins_link [expr { $npins == $P(BOUNDARY_BITS) }] \
        "$npins partition pins after link, the boundary has $P(BOUNDARY_BITS)"

    set clks [get_clocks -quiet]
    gate clocks_after_link [expr { [llength $clks] > 0 }] \
        "[llength $clks] clocks propagated from the static"

    if { $P(RM_XDC) ne "" } { read_xdc -cell $rp_cell $P(RM_XDC) }
    set_property BITSTREAM.CONFIG.PERSIST NO [current_design]

    report_drc -checks [get_drc_checks HDPR*] -file [file join $out "${name}_drc_hdpr_link.rpt"]
    set bad [drc_blockers]
    gate drc_hdpr_link [expr { [llength $bad] == 0 }] \
        [expr { [llength $bad] ? "$bad (HDPR-16: an ILA with no RM-side hub; HDPR-18/50: a clock/BSCAN/IO site pulled into the partition)" : "no HDPR-16/18/50, no Error" }]
    if { [done_after link] } { return }

    # ===========================================================================
    # STAGE 4 -- implement your RM inside the partition (the static is locked)
    # ===========================================================================
    stage impl
    opt_design
    set npins2 [llength [get_pins -quiet ${rp}/*]]
    gate rp_pins_opt [expr { $npins2 == $npins }] \
        "$npins2 partition pins after opt_design (a static-side debug core punches hub ports into the RP)"
    place_design
    phys_opt_design
    route_design

    # the routed design first: a report that fails must not cost the routing
    set routed_dcp [file join $out "${name}_routed.dcp"]
    write_checkpoint -force $routed_dcp
    set pb [get_pblocks -quiet $P(RP_PBLOCK)]
    if { $pb eq "" } { set pb [get_pblocks -quiet -of_objects [get_cells $rp]] }
    if { $pb ne "" } {
        report_utilization -pblocks $pb -file [file join $out "${name}_util.rpt"]
    } else {
        report_utilization -cells [get_cells $rp] -file [file join $out "${name}_util.rpt"]
    }
    report_timing_summary -file [file join $out "${name}_timing.rpt"]
    report_drc -file [file join $out "${name}_drc.rpt"]
    set bad [drc_blockers]
    gate drc_routed [expr { [llength $bad] == 0 }] \
        [expr { [llength $bad] ? $bad : "no HDPR-16/18/50, no Error" }]

    lassign [rp_slack $rp] wns whs nregs
    rset rm_wns $wns
    rset rm_whs $whs
    set tok [expr { ($wns eq "" || $wns >= 0) && ($whs eq "" || $whs >= 0) }]
    # An empty slack is not a parse failure: an RM with no registers (minimal: every output
    # a constant) has no path of its own, and a register with no timed path has no slack.
    if { $nregs == 0 } {
        set tdetail "your RM has no registers (every output a constant, as minimal's): no path of its own to time"
    } else {
        set tdetail "your RM's paths ($nregs registers): setup WNS [expr {$wns eq "" ? "none (no timed path)" : "$wns ns"}], hold WHS [expr {$whs eq "" ? "none (no timed path)" : "$whs ns"}]"
    }
    if { $tok || $P(ALLOW_TIMING_FAIL) ne "1" } {
        gate rm_timing $tok $tdetail
    } else {
        note rm_timing "NEGATIVE SLACK ALLOWED: setup WNS $wns ns, hold WHS $whs ns"
    }
    close_project
    if { [done_after impl] } { return }

    # ===========================================================================
    # STAGE 5 -- pr_verify: is the static in your build the static on the board?
    # ===========================================================================
    stage verify
    set ref [expr { $P(PR_VERIFY_REF) ne "" ? $P(PR_VERIFY_REF) : $P(STATIC_DCP) }]
    set prv [file join $out "${name}_pr_verify.rpt"]
    set prv_rc [catch { pr_verify $ref $routed_dcp -file $prv } msg]
    set compat 0
    if { [file isfile $prv] } {
        set fh [open $prv r]; set txt [read $fh]; close $fh
        set compat [expr { [string first " are compatible" $txt] >= 0 && [string first "not compatible" $txt] < 0 }]
    }
    rset pr_verify_ref [file tail $ref]
    gate pr_verify [expr { $compat && !$prv_rc }] \
        [expr { $compat ? "compatible with [file tail $ref]" : "NOT compatible with [file tail $ref]: $msg (see $prv)" }]
    if { [done_after verify] } { return }

    # ===========================================================================
    # STAGE 6 -- the partial + clearing pair, the probes file, the receipt
    # ===========================================================================
    stage bitstream
    open_checkpoint $routed_dcp
    set root [file join $out "${name}_partial"]
    write_bitstream -force -bin_file -cell [get_cells $rp] $root

    # The .ltx: from the SAME routed config as the partial, -cell only
    # (debug_probes.tcl:63-120; a full-design write scatters auto-named files).
    set cores {}
    foreach c [get_debug_cores -quiet] {
        if { [string match "${rp}/*" $c] } { lappend cores $c }
    }
    set ltx ""
    if { [llength $cores] > 0 } {
        set ltx [file join $out "${name}.ltx"]
        write_debug_probes -force -cell $rp $ltx
        file delete -force [file join $out "${name}_clear.ltx"]
        gate ltx_written [file isfile $ltx] "$ltx ([llength $cores] debug cores: $cores)"
    } else {
        note ltx "no debug core in the partition: no .ltx"
    }
    close_project

    foreach f [list ${root}.bin ${root}_clear.bin ${root}.bit ${root}_clear.bit] {
        gate artefact [file isfile $f] $f
    }
    set clr [file size ${root}_clear.bin]
    gate clearing_fits [expr { $clr <= $P(CLEARING_MAX) }] \
        "clearing $clr B, the harness holds $P(CLEARING_MAX) B"

    rset partial_bin  [file tail ${root}.bin]
    rset partial_len  [file size ${root}.bin]
    rset partial_crc32 [hex32 [file_crc32 ${root}.bin]]
    rset clearing_bin [file tail ${root}_clear.bin]
    rset clearing_len $clr
    rset clearing_crc32 [hex32 [file_crc32 ${root}_clear.bin]]
    if { $ltx ne "" } {
        rset ltx [file tail $ltx]
        rset ltx_crc32 [hex32 [file_crc32 $ltx]]
    }
    rset built [clock format [clock seconds] -format "%Y-%m-%dT%H:%M:%SZ" -gmt 1]
    write_receipt passed
    puts "HM_RM_BUILD_COMPLETE rm=$name rm_id=[hex32 $want_rm_id] static_id=$sid partial=${root}.bin"
    puts "next: harness-manager kit check [file join $out ${name}_build.json]"
} err]
if { $rc == 1 } {
    if { !$::gate_failed } {
        set msg [string map {"\n" " "} $err]
        puts "HM_GATE tcl_error FAIL stage=$::stage: $msg"
        lappend ::gates [list tcl_error FAIL "stage $::stage: $msg"]
        puts "HM_RM_BUILD_FAILED gate=tcl_error"
        write_receipt failed
    }
    error $err
}
